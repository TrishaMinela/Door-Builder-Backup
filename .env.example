# Server-only Zapier Catch Hook used by api/submit-door-builder.ts.
# Configure this in Vercel; never expose it as a VITE_ variable.
ZAPIER_DOOR_BUILDER_WEBHOOK_URL=
ZAPIER_AB_DOOR_BUILDER_WEBHOOK_URL=
ZAPIER_WDM_DOOR_BUILDER_WEBHOOK_URL=

# Server-only connection to the existing HGI Dealer Portal Supabase project.
# Never expose the service-role key through a VITE_ or other public variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional published Door shadow test. Use only with HGI Portal Dev credentials.
# Neither flag changes customer inventory authority or replaces local images.
VITE_PUBLISHED_CATALOG_SHADOW=false
# Server/API opt-in; local Vite enables this privately when the DEV flag is true.
# Leave false in Production. Do not prefix server credentials with VITE_.
PUBLISHED_CATALOG_READ_ENABLED=false

# Server-only Zapier Catch Hook used by api/submit-feedback.ts.
ZAPIER_FEEDBACK_WEBHOOK_URL=

# Server-only OpenAI credentials for the optional AI Visualizer prototype.
# AI prototype uses gpt-image-2.5-sunburst. Do not prefix this key with VITE_.
OPENAI_API_KEY=
